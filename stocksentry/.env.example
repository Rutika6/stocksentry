# Copy to .env and edit. NEVER commit .env to git.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
# Set to 0 to disable public sign-up (admins can still add users)
ALLOW_SIGNUP=1
# Optional: Telegram low-stock alerts (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
